{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        ring/ring-defaults {:mvn/version "0.7.1"}
        ring-cors/ring-cors {:mvn/version "0.1.13"}
        buddy/buddy-auth {:mvn/version "3.0.323"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        metosin/reitit-ring {:mvn/version "0.10.1"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        com.taoensso/telemere {:mvn/version "1.4.0"}
        tick/tick {:mvn/version "1.0.1"}
        com.xtdb/xtdb-api {:mvn/version "2.1.0"}
        com.xtdb/xtdb-core {:mvn/version "2.1.0"}}
 :aliases
 {:run-m {:main-opts ["-m" "structured-data-logger.server"]}
  :run-x {:ns-default structured-data-logger.server
          :exec-fn -main}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      ring/ring-mock {:mvn/version "0.6.2"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
