;; shadow-cljs configuration for structured-data-logger web
{:source-paths
 ["src/main"
  "src/test"]
 :dependencies
 [[lilactown/helix "0.2.2"]
  [org.babashka/sci "0.15.58"]
  [com.taoensso/telemere "1.4.0"]
  [tick/tick "1.0.1"]
  [cljs-http "0.1.49"]
  [binaryage/devtools "1.0.7"]]
 :dev-http
 {3000
  {:root "public"
   :proxy-url "http://localhost:6000/"
   :proxy-predicate structured-data-logger.build-hooks/proxy-api?}}
 :builds
 {:frontend
  {:target :browser
   :output-dir "public/js"
   :asset-path "js"
   :modules {:main {:init-fn structured-data-logger.app/init}}
   :build-hooks
   [[structured-data-logger.build-hooks/version-cljs]
    [structured-data-logger.build-hooks/version-index-resources]]}

  :test
  {:target :node-test
   :main node/main
   :output-to "out/node-tests.js"
   :autorun true
   :build-hooks
   [[structured-data-logger.build-hooks/version-cljs]]}}}
